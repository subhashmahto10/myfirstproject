#%RAML 1.0 DataType
properties:
  accountnumber:
    required: true
    minLength: 10
    maxLength: 10
  atmpin:
    required: true
    type: string
    minLength: 4
    maxLength: 4
  ifscCode:
    type: number
    required: true
    minimum: 4
    maximum: 10
  depositeAmount:
    type: number
  mailId:
    required: true
    type: string
  contact:
    required: true
    type: integer