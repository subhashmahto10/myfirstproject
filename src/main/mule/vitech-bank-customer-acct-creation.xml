	<flow name="post:\createAccounts:application\json:vitech-bank-customer-acct-creation-config">
        <set-variable value="#[attributes.queryParams.CustomerName]" doc:name="Set CustomerName" doc:id="ffe53026-c435-4a6e-ae55-e7c92468dfad" variableName="CustomerName"/>
		<set-variable value="#[attributes.queryParams.Bank]" doc:name="Bank" doc:id="d05b026c-7da4-46f2-a60a-b8f0716f5907" variableName="Bank"/>
		<set-variable value='#[attributes.queryParams."Type"]' doc:name="Type" doc:id="76d3fd19-3917-490b-acb0-c150f89b70cb" variableName="Type"/>
		<set-variable value="#[attributes.queryParams.Branchname]" doc:name="Set Branchname" doc:id="300d3ad6-efa9-4bee-a7a7-feae9f94d9f4" variableName="Branchname"/>
		<set-variable value="#[[]]" doc:name="emptyList" doc:id="a7fbe315-07e3-45e7-9c06-c13cfee3bc20" variableName="inpPayload"/>
		<set-variable value="#[%dw 2.0&#10;output application/json&#10;---&#10;&#10;vars.inpPayload &lt;&lt; payload]" doc:name="add the input payload" doc:id="ee1dda0b-1051-499c-b3f8-ff3fe71df7dc" variableName="inpPayload"/>
		<db:select doc:name="Select" doc:id="82383f81-8c73-40c8-82e3-2dfb94530874" config-ref="Database_Config1">
			<db:sql ><![CDATA[select custName, bankName from Bank_Transactions where custName=:CustomerName and bankName =:Bank]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
	"CustomerName" : vars.CustomerName,
	"Bank" : vars.Bank
}]]]></db:input-parameters>
		</db:select>
		<choice doc:name="Choice" doc:id="4f4af6ab-8d61-485c-b0eb-f1c0d464658a" >
			<when expression="sizeOf(payload)&gt;=1">
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
 	"Status" : "Account already existing with Customer"
 
 }]]></ee:set-payload>
            </ee:message>
        </ee:transform>
			</when>
			<otherwise >
				<db:insert doc:name="Insert" doc:id="5d5ed3b4-e656-4388-9125-c2cfc38493d2" config-ref="Database_Config1">
					<db:sql ><![CDATA[insert into Bank_Transactions
(custName, custAccNum, atmPin, bankName, accountType, ifscCode, branchName, transactionTimeStamp, mailId, phoneNumber)
values
(:custName, :custAccNum, :atmPin, :bankName, :accountType, :ifscCode, :branchName, :transactionTimeStamp, :mailId, :phoneNumber)]]></db:sql>
					<db:input-parameters ><![CDATA[#[{
	(vars.inpPayload map {
			"custName" : vars.CustomerName,
			"custAccNum" : $.accountnumber,
			"atmPin" : $.atmpin,
			"bankName" : vars.Bank,
			"accountType" : vars."Type",
			"ifscCode" : $.ifscCode,
			"branchName" : vars.Branchname,
			"transactionTimeStamp" : now(),
			"mailId" : $.mailId,
			"phoneNumber" : $.contact
		
		
}
)
}]]]></db:input-parameters>
				</db:insert>
				<flow-ref doc:name="Flow Reference" doc:id="84878bad-1e6d-4dc9-a3ed-2fb5cdcd0944" name="vitech-bank-customer-acct-gmail"/>
				<ee:transform doc:name="Transform Message" doc:id="79c6249f-2a79-4013-9e06-0ab891a22092">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"Success" : "CHAL DATABASE M INSERT HO GYA-LOL CICD bhi CHAL GYA yeee"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
